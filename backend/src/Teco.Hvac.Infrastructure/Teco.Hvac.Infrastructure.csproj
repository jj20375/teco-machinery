<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Teco.Hvac.Domain/Teco.Hvac.Domain.csproj" />
    <ProjectReference Include="../Teco.Hvac.Contracts/Teco.Hvac.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      P0-4 驗證結論：Pomelo.EntityFrameworkCore.MySql 9.0.0 把 Microsoft.EntityFrameworkCore.Relational
      鎖死在 [9.0.0, 9.0.999]，尚未支援 EF Core 10。與其混用 EFCore9+net10 app，
      改用 MySqlConnector + Dapper 手寫 SQL——時序資料本來就適合這樣做（分割表、批次 INSERT）。
    -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Dapper" Version="2.1.86" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>
</Project>
