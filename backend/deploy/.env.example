# 複製為 .env 並填入實際值，.env 不進版控

# ==========================================
# 資料庫與安全金鑰設定
# ==========================================
# MariaDB root 超級管理員密碼
DB_ROOT_PASSWORD=

# 應用程式（teco_app）存取 MariaDB 的密碼
DB_APP_PASSWORD=

# Collector 採集器與 API 內部溝通的認證 Token
INTERNAL_TOKEN=

# API 簽發與驗證 JWT Token 的密鑰（HMAC-SHA256，長度需至少 32 字元）
JWT_SIGNING_KEY=

# 資料庫檔案存放位置。開發機留空（使用 Docker 具名 volume）；
# 現場 VM 填獨立資料碟上的路徑，例如 /srv/teco-data/mariadb（見 docs/正式機首次部署手冊.md 附錄 C）
# ⚠️ 已經有資料之後不要隨意更改，改了等於換成另一個空的資料庫
DB_DATA_DIR=

# ==========================================
# 現場設備通訊設定（Modbus / 閘道器）
# ==========================================
# 漢鐘冰機 (Hanbell) Modbus 閘道器 IP 位址
HANBELL_IP=192.168.10.198

# 漢鐘冰機 Modbus 閘道器通訊 Port 埠號
HANBELL_PORT=4196

# 漢鐘冰機串口通訊鮑率 (Baud Rate)
HANBELL_BAUD=9600

# DDC 控制器 1 IP 位址
DDC1_IP=192.168.10.12

# DDC 控制器 1 Modbus TCP 通訊 Port 埠號
DDC1_PORT=502

# DDC 控制器 2 IP 位址
DDC2_IP=192.168.10.14

# DDC 控制器 2 Modbus TCP 通訊 Port 埠號
DDC2_PORT=502

# ==========================================
# 資料保留設定
# ==========================================
# 「原始讀值」保留幾天，超過的月份會由 API 每天一次整個月份刪除（DROP PARTITION），刪掉就救不回來。
# 每小時彙總表（報表用的歷史資料）永久保留，不受這兩個設定影響。
# 留空 = 使用預設值。改完執行 `docker compose up -d api` 重建 API 容器，隔天排程才會套用。
# ⚠️ 安全下限 30 天：填低於 30 或不是整數會被拒絕、改用預設值，並在 API log 寫警告，避免打錯字誤刪歷史資料。
# ⚠️ 縮短天數 = 下次排程就刪掉超過的資料；加長天數則不會找回已經刪掉的資料。

# FCU 原始讀值保留天數（預設 90，約占 7 MB／天）
RETENTION_FCU_DAYS=

# 冰水主機原始讀值保留天數（預設 180，約占 2 MB／天）
RETENTION_CHILLER_DAYS=

# ==========================================
# 前端與跨網域設定
# ==========================================
# 前端網頁來源網址（供 API CORS 白名單允許跨域請求，例如 http://localhost:4321 或正式站台網址）
FRONTEND_ORIGIN=http://localhost:4321
