# 複製為 .env 並填入實際值，.env 不進版控

# ==========================================
# 資料庫與安全金鑰設定
# ==========================================
# MariaDB root 超級管理員密碼
DB_ROOT_PASSWORD=

# 應用程式（teco_app）存取 MariaDB 的密碼
DB_APP_PASSWORD=

# Collector 採集器與 API 內部溝通的認證 Token
INTERNAL_TOKEN=

# API 簽發與驗證 JWT Token 的密鑰（HMAC-SHA256，長度需至少 32 字元）
JWT_SIGNING_KEY=

# ==========================================
# 現場設備通訊設定（Modbus / 閘道器）
# ==========================================
# 漢鐘冰機 (Hanbell) Modbus 閘道器 IP 位址
HANBELL_IP=192.168.10.198

# 漢鐘冰機 Modbus 閘道器通訊 Port 埠號
HANBELL_PORT=4196

# 漢鐘冰機串口通訊鮑率 (Baud Rate)
HANBELL_BAUD=9600

# DDC 控制器 1 IP 位址
DDC1_IP=192.168.10.12

# DDC 控制器 1 Modbus TCP 通訊 Port 埠號
DDC1_PORT=502

# DDC 控制器 2 IP 位址
DDC2_IP=192.168.10.14

# DDC 控制器 2 Modbus TCP 通訊 Port 埠號
DDC2_PORT=502

# ==========================================
# 前端與跨網域設定
# ==========================================
# 前端網頁來源網址（供 API CORS 白名單允許跨域請求，例如 http://localhost:4321 或正式站台網址）
FRONTEND_ORIGIN=http://localhost:4321
